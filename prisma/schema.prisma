datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =======================
// ENUMS
// =======================
enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  OTP_SENT
  PASSWORD_CHANGED
  PASSWORD_RESET
  ACCOUNT_BLOCKED
  ACCOUNT_UNBLOCKED
  ACCOUNT_VERIFIED
  LOGIN_ALERT
  ADMIN_NEW_PROVIDER_REQUEST
  BOOKING_CREATED
  BOOKING_QUOTE_SENT
  BOOKING_QUOTE_CONFIRMED
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  BOOKING_COMPLETED
  BOOKING_CANCELLED
  PROVIDER_APPROVED
  PROVIDER_REJECTED
  PROVIDER_REGISTERED
  SERVICE_APPROVED
  SERVICE_REJECTED
  PAYMENT_CONFIRMED
  EVENT_CANCELLED
  GENERAL

  // Packages
  PACKAGE_JOIN_REQUESTED
  PACKAGE_ACTIVATED
  PACKAGE_JOIN_ACCEPTED
  PACKAGE_JOIN_REJECTED
  PACKAGE_PARTNER_LEFT
  PACKAGE_BOOKING_REQUESTED
  PACKAGE_BOOKING_ACCEPTED
  PACKAGE_BOOKING_REJECTED
  PACKAGE_PAYMENT_CASH_CHOSEN
  PACKAGE_PAYMENT_CONFIRMED
  PACKAGE_BOOKING_PAYMENT_EXPIRED

  // Discounts (docs/discounts-implementation-plan.md §7)
  DISCOUNT_CANCELLED

  // Reviews (docs/reviews-implementation-plan.md §6)
  REVIEW_REPLIED

  // Complaints (docs/complaints-implementation-plan.md §6)
  COMPLAINT_STATUS_CHANGED
  COMPLAINT_REPLIED

  // Payments (docs/payments-implementation-plan.md §8)
  PAYMENT_FAILED

  // Delivery (docs/delivery-implementation-plan.md §6)
  DELIVERY_OUT_FOR_DELIVERY
  DELIVERY_COMPLETED
  DELIVERY_FAILED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum Platform {
  IOS
  ANDROID
  WEB
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  BLOCK
  UNBLOCK
  VERIFY
  PASSWORD_CHANGE
  PASSWORD_RESET
  APPROVE
  REJECT
  BOOKING_CREATE
  BOOKING_QUOTE
  BOOKING_ACCEPT
  BOOKING_REJECT
  BOOKING_COMPLETE
  BOOKING_CANCEL
}

enum CapacityUnit {
  BOOKING
  ITEM
  SESSION
}

enum EventType {
  WEDDING
  ENGAGEMENT
  BABY_SHOWER
  GRADUATION
  CONFERENCE
  BIRTHDAY
  ALL_EVENTS
  OTHER
}

enum DayOfWeek {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum ServiceStatus {
  PENDING_APPROVAL
  PENDING_DETAILS
  ACTIVE
  INACTIVE
  REJECTED
}

enum FileType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum BookingStatus {
  PENDING
  QUOTE_SENT
  CONFIRMED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EventStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ChangeRequestTargetType {
  SERVICE
  SUB_SERVICE
}

enum ChangeRequestType {
  CREATE
  UPDATE
}

// =======================
// PACKAGES
// =======================
enum PackageStatus {
  DRAFT
  ACTIVE
  CANCELLED
}

enum PackageServiceStatus {
  PENDING_PROVIDER_APPROVAL
  ACTIVE
  REJECTED
}

enum PackageEventBookingStatus {
  PENDING
  CONFIRMED
  PENDING_PAYMENT
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
}

enum SuggestedPackageStatus {
  ACTIVE
  INACTIVE
}

enum ServicePriceType {
  FLAT
  PER_GUEST
}

// =======================
// DISCOUNTS
// =======================
enum DiscountScope {
  SERVICE
  PACKAGE
}

enum DiscountOrigin {
  PROVIDER
  COMPANY_FUNDED
}

enum DiscountStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// =======================
// FAVORITES
// =======================
enum FavoriteTargetType {
  SERVICE
  PROVIDER
  PACKAGE
}

// =======================
// COMPLAINTS
// =======================
enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ComplaintTargetType {
  PROVIDER
  SERVICE
  BOOKING
  PACKAGE_BOOKING
  CUSTOMER
  GENERAL
}

// =======================
// PAYMENTS
// =======================
enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

// =======================
// DELIVERY
// =======================
enum FulfillmentStatus {
  SCHEDULED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

// =======================
// SERVICE TYPE
// =======================
model ServiceType {
  id                        String    @id @default(uuid())
  name                      String    @unique
  description               String?
  services                  Service[]
  isVenue                   Boolean   @default(false)
  requiresDeliveryByDefault Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

// =======================
// USER
// =======================
model User {
  id            String        @id @default(uuid())
  fullName      String
  email         String        @unique
  latitude      Float?
  longitude     Float?
  locationName  String?
  passwordHash  String?
  googleId      String?       @unique
  phoneNumber   String?
  profileImage  String?
  role          UserRole
  status        AccountStatus @default(PENDING)
  emailVerified Boolean       @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  deletedAt DateTime?

  customer               Customer?
  provider               ServiceProvider?
  bankAccount            BankAccount?
  refreshTokens          RefreshToken[]
  notifications          Notification[]
  deviceTokens           DeviceToken[]
  auditLogs              AuditLog[]             @relation("UserAuditLogs")
  bookings               Booking[]
  events                 Event[]
  reviewedChangeRequests ServiceChangeRequest[] @relation("ChangeRequestReviewer")

  favorites       Favorite[]
  reviews         Review[]
  payments             Payment[]
  packageEventBookings PackageEventBooking[]
  complaints      Complaint[]
}

model Customer {
  id            String @id @default(uuid())
  loyaltyPoints Int    @default(0)
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceProvider {
  id              String         @id @default(uuid())
  businessName    String
  businessLicense String
  description     String?
  approvalStatus  ApprovalStatus @default(PENDING)
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  services        Service[]
  bookings        Booking[]
  blockedSlots    BlockedSlot[]
  packages        Package[]
  packageServices PackageService[]
}

// =======================
// SERVICE
// =======================
model Service {
  id            String @id @default(uuid())
  providerId    String
  serviceTypeId String

  provider    ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceType ServiceType     @relation(fields: [serviceTypeId], references: [id])

  description  String?
  latitude     Float?
  longitude    Float?
  locationName String?

  businessFile String?
  serviceLogo  String?

  approvalStatus ServiceStatus @default(PENDING_APPROVAL)
  isCompleted    Boolean       @default(false)

  isPackaged   Boolean @default(false)
  rating       Float   @default(0)
  totalReviews Int     @default(0)

  minCapacity Int?
  maxCapacity Int?
  price       Float?
  priceType   ServicePriceType @default(FLAT)



  files        ServiceDetailFile[]
  eventTypes   ServiceEventType[]
  subServices  SubService[]
  availability ServiceAvailability[]
  workingDays  ServiceWorkingDay[]
  bookings     Booking[]
  blockedSlots BlockedSlot[]
  packageServices   PackageService[]
  suggestedPackages SuggestedPackage[]
  discounts    Discount[]
  reviews      Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// FILES
// =======================
model ServiceDetailFile {
  id        String   @id @default(uuid())
  serviceId String
  fileUrl   String
  fileType  FileType
  publicId  String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  uploadedAt DateTime @default(now())
}

// =======================
// EVENT TYPE RELATION
// =======================
model ServiceEventType {
  id        String    @id @default(uuid())
  serviceId String
  eventType EventType

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, eventType])
}

// =======================
// SUB SERVICE
// =======================
model SubService {
  id        String  @id @default(uuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  pricePerUnit   Float
  unitType       String        @default("unit")
  dailyCapacity  Int           @default(1)
  isAvailable    Boolean       @default(false)
  approvalStatus ServiceStatus @default(PENDING_APPROVAL)

  media        SubServiceMedia[]
  bookingItems BookingItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// SUB SERVICE MEDIA
// =======================
model SubServiceMedia {
  id           String   @id @default(uuid())
  subServiceId String
  url          String
  type         FileType
  publicId     String?

  subService SubService @relation(fields: [subServiceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// =======================
// AVAILABILITY
// =======================
model ServiceAvailability {
  id        String @id @default(uuid())
  serviceId String

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  workFromTime String
  workToTime   String
  capacity     Int    @default(1)

  hasSlots Boolean @default(false)

  timeSlots   TimeSlot[]
  workingDays ServiceWorkingDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// WORKING DAYS
// =======================
model ServiceWorkingDay {
  id             String    @id @default(uuid())
  serviceId      String?
  availabilityId String
  dayOfWeek      DayOfWeek

  service      Service?            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  availability ServiceAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

  @@unique([availabilityId, dayOfWeek])
}

// =======================
// TIME SLOTS
// =======================
model TimeSlot {
  id             String @id @default(uuid())
  availabilityId String

  availability ServiceAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)

  fromTime String
  toTime   String
  capacity Int    @default(1)

  bookings Booking[]
}

// =======================
// BOOKING
// =======================
model Booking {
  id String @id @default(uuid())

  customerId String
  customer   User   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  providerId String
  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  timeSlotId String?
  timeSlot   TimeSlot? @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  // set when this booking was created as part of a package purchase
  packageEventBookingId String?
  packageEventBooking   PackageEventBooking? @relation(fields: [packageEventBookingId], references: [id], onDelete: SetNull)

  customerNotes   String?
  providerNotes   String?
  rejectionReason String?

  totalAmount Float  @default(0)
  finalAmount Float?

  discountId     String?
  discount       Discount? @relation(fields: [discountId], references: [id])
  discountAmount Float?

  status BookingStatus @default(PENDING)

  acceptedAt  DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  cancellationDeadline DateTime?
  cancelledBy          String?
  cancellationReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items BookingItem[]

  review   Review?
  payment  Payment?
  delivery Delivery?

  @@index([customerId])
  @@index([serviceId])
  @@index([providerId])
  @@index([eventId])
  @@index([packageEventBookingId])
}

model BookingItem {
  id String @id @default(uuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  subServiceId String
  subService   SubService @relation(fields: [subServiceId], references: [id], onDelete: Cascade)

  quantity       Int    @default(1)
  unitPrice      Float
  finalUnitPrice Float?

  totalPrice      Float
  finalTotalPrice Float?

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([subServiceId])
}

model BankAccount {
  id                String  @id @default(uuid())
  iban              String
  bankName          String
  accountHolderName String
  isVerified        Boolean @default(false)
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id             String           @id @default(uuid())
  title          String
  body           String
  type           NotificationType
  isRead         Boolean          @default(false)
  deliveryStatus DeliveryStatus   @default(PENDING)
  metadata       Json?
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId])
  @@index([deliveryStatus])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String
  platform  Platform @default(WEB)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

model AuditLog {
  id        String      @id @default(uuid())
  action    AuditAction
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  userId    String?
  user      User?       @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model Event {
  id              String           @id @default(uuid())
  customerId      String
  customer        User             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name            String
  eventType       EventType
  eventDate       DateTime
  eventStartTime  String
  eventEndTime    String
  eventLocation   String?
  numberOfGuests  Int?
  customerNotes   String?
  status          EventStatus      @default(DRAFT)
  archivedAt      DateTime?
  bookings        Booking[]
  packageEventBookings PackageEventBooking[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([customerId])
}

// =======================
// SERVICE CHANGE REQUEST
// =======================
model ServiceChangeRequest {
  id          String                  @id @default(uuid())
  targetType  ChangeRequestTargetType
  targetId    String
  requestType ChangeRequestType
  payload     Json
  status      ApprovalStatus          @default(PENDING)

  reviewedBy String?
  reviewer   User?   @relation("ChangeRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([status])
}

model BlockedSlot {
  id         String          @id @default(uuid())
  serviceId  String
  service    Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  providerId String
  provider   ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  date       DateTime
  fromTime   String?
  toTime     String?
  reason     String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([serviceId])
  @@index([providerId])
  @@index([date])
}

// =======================
// PACKAGES
// docs/packages-implementation-plan.md
// =======================
model Package {
  id                 String           @id @default(uuid())
  providerId         String
  provider           ServiceProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  discountPercentage Float?           @default(0)
  status             PackageStatus    @default(DRAFT)

  services      PackageService[]
  eventBookings PackageEventBooking[]
  discounts     Discount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
  @@index([status])
}

model PackageService {
  id         String               @id @default(uuid())
  packageId  String
  package    Package              @relation(fields: [packageId], references: [id], onDelete: Cascade)
  providerId String
  provider   ServiceProvider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service              @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  status     PackageServiceStatus @default(PENDING_PROVIDER_APPROVAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([packageId, serviceId])
}

model PackageEventBooking {
  id         String                    @id @default(uuid())
  packageId  String
  package    Package                   @relation(fields: [packageId], references: [id])
  customerId String
  customer   User                      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  eventId    String?
  event      Event?                    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  status     PackageEventBookingStatus @default(PENDING)
  totalAmount Float                    @default(0)

  bookings Booking[]
  payment  Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId])
  @@index([customerId])
  @@index([status])
}

model SuggestedPackage {
  id          String                 @id @default(uuid())
  name        String
  description String?
  status      SuggestedPackageStatus @default(ACTIVE)

  services Service[] // Implicit m-n relation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =======================
// DISCOUNTS
// docs/discounts-implementation-plan.md
// =======================
model Discount {
  id                  String         @id @default(uuid())
  scope               DiscountScope
  serviceId           String?
  service             Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  packageId           String?
  package             Package?       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  origin              DiscountOrigin
  code                String?        @unique
  percentOff          Float
  status              DiscountStatus @default(ACTIVE)
  needsReconfirmation Boolean        @default(false)
  startsAt            DateTime?
  endsAt              DateTime?
  createdByUserId     String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  payments Payment[]
  bookings Booking[]

  @@index([scope])
  @@index([status])
}

// =======================
// FAVORITES
// docs/favorites-implementation-plan.md
// =======================
model Favorite {
  id         String             @id @default(uuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType FavoriteTargetType
  targetId   String
  createdAt  DateTime           @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId])
}

// =======================
// REVIEWS & RATINGS
// docs/reviews-implementation-plan.md
// =======================
model Review {
  id            String   @id @default(uuid())
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId    String
  customer      User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String?
  providerReply String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([serviceId])
}

// =======================
// GENERAL COMPLAINTS
// docs/complaints-implementation-plan.md
// =======================
model Complaint {
  id               String              @id @default(uuid())
  complainantId    String
  complainant      User                @relation(fields: [complainantId], references: [id], onDelete: Cascade)
  targetType       ComplaintTargetType
  targetId         String?
  bookingId        String?
  packageEventBookingId String?
  subject          String
  description      String
  status           ComplaintStatus     @default(PENDING)
  adminReply       String?
  handledByUserId  String?
  resolvedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([complainantId])
  @@index([status])
}

// =======================
// PAYMENTS
// docs/payments-implementation-plan.md
// =======================
model Payment {
  id                String        @id @default(uuid())
  bookingId             String?              @unique
  booking               Booking?             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  packageEventBookingId String?              @unique
  packageEventBooking   PackageEventBooking? @relation(fields: [packageEventBookingId], references: [id], onDelete: Cascade)
  payerId           String
  payer             User          @relation(fields: [payerId], references: [id], onDelete: Cascade)
  amount            Float
  subtotalAmount    Float
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  discountId        String?
  discount          Discount?     @relation(fields: [discountId], references: [id])
  discountAmount    Float?
  providerReference String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

// =======================
// DELIVERY
// docs/delivery-implementation-plan.md
// =======================
model Delivery {
  id          String            @id @default(uuid())
  bookingId   String            @unique
  booking     Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status      FulfillmentStatus @default(SCHEDULED)
  address     String
  scheduledAt DateTime?
  deliveredAt DateTime?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}
